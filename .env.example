APP_NAME=ARCAFISH
ENVIRONMENT=local
DATABASE_URL=sqlite:///./arcafish.db
CANARY_TIMEZONE=Atlantic/Canary
FORECAST_DAYS=7
FORECAST_CACHE_TTL_MINUTES=60
HTTP_TIMEOUT_SECONDS=12
HTTP_VERIFY_SSL=true
WEATHER_ENSEMBLE_ENABLED=true

# Proveedores futuros opcionales. El MVP funciona sin claves usando Open-Meteo.
METNO_USER_AGENT=ARCAFISH local app (contact: local-user)
AEMET_API_KEY=
STORMGLASS_API_KEY=
WORLDTIDES_API_KEY=
